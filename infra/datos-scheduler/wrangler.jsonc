// datos-scheduler: dispatches the "Live data → KV" GitHub workflow on a schedule.
// Secret (never in this file): GITHUB_DISPATCH_TOKEN, set with `wrangler secret put`.
// Always pass --config ./wrangler.jsonc: the repo root has the site's generated .wrangler/ config.
{
  "name": "datos-scheduler",
  "main": "index.ts",
  "compatibility_date": "2026-10-08",
  // No public surface.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *", "7 * * * *"] },
  // Logs of scheduled runs only: this Worker serves no visitors.
  "observability": { "enabled": true },
}
